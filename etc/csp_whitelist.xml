<?xml version="1.0"?>
<!--
/**
 * InkThread Decoration Pricing: the product page previews the customer's chosen artwork from a local blob: URL.
 */
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="img-src">
            <values>
                <value id="inkthread-artwork-preview" type="host">blob:</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
