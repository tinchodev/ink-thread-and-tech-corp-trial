<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_type_prepare_full_options">
        <observer name="inkthread_decoration_capture_selection"
                  instance="InkThread\DecorationPricing\Observer\CaptureDecorationSelection"/>
    </event>
    <event name="catalog_product_type_prepare_lite_options">
        <observer name="inkthread_decoration_capture_selection"
                  instance="InkThread\DecorationPricing\Observer\CaptureDecorationSelection"/>
    </event>
    <event name="sales_quote_collect_totals_before">
        <observer name="inkthread_decoration_calculate_fees"
                  instance="InkThread\DecorationPricing\Observer\CalculateDecorationFees"/>
    </event>
</config>
