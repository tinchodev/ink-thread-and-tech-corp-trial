<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="InkThread\DecorationPricing\Api\PriceTableProviderInterface"
                type="InkThread\DecorationPricing\Model\Config\PriceTableProvider"/>

    <type name="Magento\Catalog\Model\Product\Type\Price">
        <plugin name="inkthread_decoration_add_fee"
                type="InkThread\DecorationPricing\Plugin\AddDecorationFeeToFinalPrice"/>
    </type>
    <type name="Magento\Catalog\Helper\Product\Configuration">
        <plugin name="inkthread_decoration_item_options"
                type="InkThread\DecorationPricing\Plugin\AddDecorationToItemOptions"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Item\ToOrderItem">
        <plugin name="inkthread_decoration_order_snapshot"
                type="InkThread\DecorationPricing\Plugin\CopyDecorationToOrderItem"/>
    </type>
</config>
